// PathfinderOccupancy.hook
// Hook into Moho::CAiSteeringImpl::TaskTick (0x5D32B0).
// Overwrites the 6-byte prolog (55 8B EC 83 E4 F8 = push ebp / mov ebp,esp /
// and esp,F8) with a JMP to our observer thunk. The thunk preserves all
// registers, calls our C handler, then re-executes the overwritten prolog
// instructions and jumps back to 0x5D32B6 (sub esp, 58h).
0x005D32B0:
    jmp @OnTickObserveHook
    nop
